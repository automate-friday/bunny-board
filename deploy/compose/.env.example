# Bunny compose settings. Copy to .env and edit; every line is optional.

# --- Agent runtime ----------------------------------------------------------------
# local-runtime: run the agent runtime (Paseo daemon + Claude Code + Codex) in this stack.
# Remove it (COMPOSE_PROFILES=) and set RUNTIME_WS to use a runtime elsewhere.
COMPOSE_PROFILES=local-runtime
# RUNTIME_WS=ws://runtime:6767/ws

# --- Where people open the board ------------------------------------------------------
# Local: http://localhost:8080, published on this machine's loopback only. Publishing on
# other interfaces (8080 or 0.0.0.0:8080) lets anyone who can reach the machine in, so
# turn auth on first (below) and use encrypted transport. README › Network boundary.
BOARD_PUBLIC_URL=http://localhost:8080
BOARD_HTTP_PORT=127.0.0.1:8080
BOARD_HTTPS_PORT=127.0.0.1:8443
# PUBLIC_HOST=board.example.com

# App auth (recommended): copy the two lines below into ./board-auth.env (gitignored), not
# into this file. Both set: the board asks for them; frame agents keep their own tokens.
# No board-auth.env: auth off. An empty value: the board refuses to start.
#   BUNNYBOARD_AUTH_USERNAME=board
#   BUNNYBOARD_AUTH_PASSWORD=<long random password>

# Proxy basic auth (optional, Caddy, in front of everything but /api/agent/*).
# Hash: docker compose run --rm proxy caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ signs.
# BOARD_AUTH=on
# BOARD_AUTH_USER=board
# BOARD_AUTH_HASH='$2a$14$...'

# tldraw production licence: a file holding your key, used at image build time.
# TLDRAW_LICENSE_KEY_FILE=./tldraw-license.txt

# --- Board --------------------------------------------------------------------------
# The name agents call you in their prompts (default: User).
# BOARD_HUMAN_NAME=Sam
# Provider/model for new frame agents (claude/<model> or codex/<model>).
# BOARD_DEFAULT_PROVIDER=claude/claude-opus-5-5
# board (default): each board's agents start in a scratch dir under the board volume.
# repo: they start in BOARD_DEFAULT_CWD (e.g. a repo you cloned into the workspaces volume).
# BOARD_FRAME_CONTEXT=board
# BOARD_DEFAULT_CWD=/workspaces

# --- Remote runtime (runtime on another machine) ------------------------------------------
# Paths and URLs below are as seen from the runtime host. See README › Remote runtime.
# RUNTIME_WS=ws://100.x.y.z:6767/ws
# BOARD_DIRECT_PORT=0.0.0.0:8793
# BOARD_AGENT_URL=http://100.a.b.c:8793
# BOARD_MCP_ENTRY=/path/on/runtime/host/bunny/mcp/board-mcp.mjs
# BOARD_MCP_NODE=node
# BOARD_FRAME_CONTEXT=repo
# BOARD_DEFAULT_CWD=/path/on/runtime/host/workspace
