{
  "name": "bunny",
  "private": true,
  "license": "BUSL-1.1",
  "version": "0.0.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "mcp/",
    "canvas/dist/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:canvas": "cd canvas && npm run build",
    "build:server": "esbuild server/core.ts --bundle --platform=node --format=cjs --target=node20 --minify --keep-names --outfile=server/dist/core.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "build:standalone": "esbuild server/standalone.ts --bundle --platform=node --format=cjs --target=node20 --minify --keep-names --outfile=server/dist/standalone.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "build:cli": "esbuild server/backup/bin.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/dist/bunny.cjs --log-level=warning",
    "build": "npm run build:server && npm run build:standalone && npm run build:cli && npm run build:runtime-host && npm run build:canvas",
    "test:unit": "esbuild test/unit.test.ts --bundle --platform=node --format=cjs --target=node20 --outfile=test/.unit.cjs --external:bufferutil --external:utf-8-validate --log-level=warning && node --test test/.unit.cjs test/codex-cloud.test.mjs test/frame-start-mcp.test.mjs && npm run test:runtime",
    "test:board-env": "node --test test/board-env.test.mjs",
    "test:inbox": "node --test test/inbox-sidecar.test.mjs",
    "test": "npm run test:unit && npm run test:board-env && npm run test:inbox",
    "test:feedback-coverage": "node test/feedback-coverage.mjs",
    "bench:bundle": "esbuild bench/run.ts --bundle --platform=node --format=cjs --target=node20 --outfile=bench/.bench.cjs --external:playwright --external:bufferutil --external:utf-8-validate --log-level=warning && esbuild bench/compare.ts --bundle --platform=node --format=cjs --target=node20 --outfile=bench/.compare.cjs --log-level=warning",
    "bench": "npm run build && npm run bench:bundle && node bench/.bench.cjs",
    "bench:run": "npm run bench:bundle && node bench/.bench.cjs",
    "bench:compare": "npm run bench:bundle && node bench/.compare.cjs",
    "build:runtime-host": "esbuild server/runtime-host.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/dist/runtime-host.cjs --external:bufferutil --external:utf-8-validate --log-level=warning && esbuild server/runtime-tool-client.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/dist/runtime-tool-client.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "test:runtime": "npm run build:runtime-host && esbuild test/runtime-files.test.ts --bundle --platform=node --format=cjs --target=node20 --outfile=test/.runtime-files.cjs --log-level=warning && node --test test/.runtime-files.cjs",
    "bench:phone": "esbuild bench/phone.ts --bundle --platform=node --format=cjs --target=node20 --outfile=bench/.phone.cjs --external:playwright --external:bufferutil --external:utf-8-validate --log-level=warning && node bench/.phone.cjs",
    "bench:phone:soak": "npm run bench:phone -- --soak 50 --out bench/out/phone-soak",
    "bench:phone:images": "npm run bench:phone -- --images --out bench/out/phone-images",
    "bench:phone:overview": "npm run bench:phone -- --overview --out bench/out/phone-overview"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.11.4",
    "@getpaseo/plugin": "0.11.4",
    "@getpaseo/protocol": "^0.11.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tldraw/sync-core": "^5.2.2",
    "@tldraw/tlschema": "^5.2.2",
    "@tldraw/utils": "^5.2.2",
    "@tldraw/validate": "^5.2.2",
    "effect": "3.22.4",
    "jpeg-js": "0.4.4",
    "ws": "^8.22.0"
  }
}
