{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@tldraw/tlschema": ["./node_modules/@tldraw/tlschema"],
      "@tldraw/validate": ["./node_modules/@tldraw/validate"]
    }
  },
  "include": ["src"]
}
